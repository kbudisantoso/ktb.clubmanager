{
  "name": "ktb-clubmanager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Open-Source Vereinsverwaltung mit doppelter Buchführung (SKR42)",
  "license": "MIT",
  "author": "ktb.clubmanager",
  "scripts": {
    "dev": "dotenv -e .env.local -- pnpm -r --parallel dev",
    "dev:web": "dotenv -e .env.local -- pnpm --filter @ktb/web dev",
    "dev:api": "dotenv -e .env.local -- pnpm --filter @ktb/api dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:web": "pnpm --filter @ktb/web test",
    "test:api": "pnpm --filter @ktb/api test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare-commit": "pnpm lint && pnpm format:check",
    "prepare-push": "pnpm install && pnpm prepare-commit && pnpm typecheck && pnpm test",
    "prepare": "simple-git-hooks",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:export": "tsx prisma/scripts/export-club.ts",
    "db:import": "tsx prisma/scripts/import-club.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "better-auth": "^1.7.13",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "pg": "^8.23.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm prepare-commit",
    "pre-push": "pnpm prepare-push"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "simple-git-hooks"
    ]
  }
}
